              "camera_id": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "camera_id",
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
